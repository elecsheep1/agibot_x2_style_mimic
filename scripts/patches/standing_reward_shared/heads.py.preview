"""平地速度任务的可微奖励与终止判断。"""

from dataclasses import dataclass
import math

import torch
from torch import nn

from ...utils.standing_reward import (
    standing_quality as shared_standing_quality,
    standing_limb_quality_tensor,
)

from .state import unpack_state
from ...utils.rotation import (
    normalize_quaternion,
    inverse_rotate_vector,
)


@dataclass(frozen=True)
class GetupTaskCfg:
    step_dt: float = 0.02
    standing_weight: float = 1.0
    style_weight: float = 1.0
    action_rate_weight: float = 0.005
    joint_limit_weight: float = 0.5
    joint_acc_weight: float = 1e-7
    boundary_weight: float = 5.0
    soft_limit_fraction: float = 0.9
    max_distance: float = 2.0
    boundary_transition: float = 0.1
    stance_width: float = 0.34
    toe_out_rad: float = 0.08726646
    limb_fraction: float = 0.20


class GetupTask(nn.Module):
    """倒地起身任务的可微奖励与终止判断。"""

    def __init__(
        self,
        spec,
        joint_limits,
        cfg,
        kinematics,
        control_joint_ids,
    ):
        super().__init__()

        self.spec = spec
        self.cfg = cfg
        self.kinematics = kinematics

        if not all(
            math.isfinite(value)
            for value in vars(cfg).values()
        ):
            raise ValueError("起身任务配置必须全部为有限数值")
        if min(
            cfg.step_dt,
            cfg.max_distance,
            cfg.boundary_transition,
        ) <= 0:
            raise ValueError("控制周期、越界距离和过渡宽度必须大于零")
        if not 0.0 < cfg.soft_limit_fraction <= 1.0:
            raise ValueError("soft_limit_fraction 必须在 (0, 1] 内")

        weights = (
            cfg.standing_weight,
            cfg.style_weight,
            cfg.action_rate_weight,
            cfg.joint_limit_weight,
            cfg.joint_acc_weight,
            cfg.boundary_weight,
        )

        if min(weights) < 0:
            raise ValueError("奖励和惩罚权重必须为非负数")

        limits = (
            torch.as_tensor(joint_limits)
            .detach()
            .clone()
            .float()
        )

        if limits.shape != (spec.num_joints, 2):
            raise ValueError("joint_limits 必须为 [全部关节数量, 2]")
        if (
            not bool(torch.isfinite(limits).all())
            or bool(
                (limits[:, 0] >= limits[:, 1]).any()
            )
        ):
            raise ValueError("关节限位必须有限，且下限小于上限")

        center = limits.mean(dim=-1)
        half_range = (
            (limits[:, 1] - limits[:, 0])
            * 0.5
            * cfg.soft_limit_fraction
        )
        self.register_buffer(
            "lower_limits",
            center - half_range,
        )
        self.register_buffer(
            "upper_limits",
            center + half_range,
        )

        joint_ids = (
            torch.as_tensor(
                control_joint_ids,
                dtype=torch.long,
            )
            .detach()
            .clone()
        )

        if (
            joint_ids.shape != (spec.num_actions,)
            or joint_ids.unique().numel() != joint_ids.numel()
            or bool(
                (
                    (joint_ids < 0) | (joint_ids >= spec.num_joints)
                ).any()
            )
        ):
            raise ValueError("控制关节索引必须数量正确、不重复且未越界")

        self.register_buffer(
            "control_joint_ids",
            joint_ids,
        )

        body_names = list(kinematics.body_names)

        if "torso_link" not in body_names:
            raise ValueError("可微运动学必须包含 torso_link")

        self.torso_index = body_names.index(
            "torso_link"
        )

        joint_names = list(kinematics.joint_names)
        limb_names = [
            f"{side}_{part}_joint"
            for side in ("left", "right")
            for part in ("shoulder_pitch", "shoulder_roll", "shoulder_yaw",
                         "elbow", "wrist_yaw", "wrist_pitch", "wrist_roll")
        ]
        foot_names = ["left_ankle_roll_link", "right_ankle_roll_link"]
        missing = [name for name in limb_names if name not in joint_names]
        missing += [name for name in foot_names if name not in body_names]
        if missing:
            raise ValueError(f"站姿评分缺少关节或刚体：{missing}")
        self.register_buffer("limb_joint_ids", torch.tensor(
            [joint_names.index(name) for name in limb_names], dtype=torch.long))
        self.register_buffer("stance_foot_ids", torch.tensor(
            [body_names.index(name) for name in foot_names], dtype=torch.long))
        self.register_buffer("limb_joint_targets", torch.tensor([
            .20, .15, 0., -.30, 0., 0., 0.,
            .20, -.15, 0., -.30, 0., 0., 0.,
        ]))
        if not 0.0 <= cfg.limb_fraction <= 1.0:
            raise ValueError("肢体姿态比例必须在 [0, 1] 内")
        if cfg.stance_width <= 0:
            raise ValueError("目标站宽必须大于零")

    @staticmethod
    def upright_component(quaternion):
        """计算刚体局部竖直轴在世界竖直方向上的分量。"""
        quaternion = normalize_quaternion(
            quaternion
        )

        # 1 - 2sin²(θ/2) = cos(θ)
        # 计算的是机器人自身 Z 轴与世界 Z 轴夹角的余弦，用来衡量直立程度
        return 1.0 - 2.0 * (
            quaternion[..., 0].square()
            + quaternion[..., 1].square()
        )

    def standing_quality(self, state, feet_support=None, wrist_load=None):
        """共享站立公式；未传接触输入时保留旧版速度代理，不代表真实接触。"""
        fields = unpack_state(state, self.spec)
        body_pose, _ = self.kinematics(
            root_pose=fields["root_pose"],
            root_velocity=fields["root_velocity"],
            joint_position=fields["joint_position"],
            joint_velocity=fields["joint_velocity"],
        )
        if (feet_support is None) != (wrist_load is None):
            raise ValueError("双脚支撑和手部载荷必须同时提供")
        velocity = fields["root_velocity"]
        if feet_support is None:
            # 等价恢复旧公式的 stability 分支；这只是过渡代理。
            feet_support = torch.exp(
                -velocity[:, :3].square().sum(-1) / 0.25**2
                -velocity[:, 3:].square().sum(-1) / 0.60**2
            )
            wrist_load = torch.zeros_like(feet_support)
        limb = standing_limb_quality_tensor(
            q=fields["joint_position"][:, self.limb_joint_ids],
            root_q=fields["root_pose"][:, 3:7],
            feet=body_pose[:, self.stance_foot_ids],
            joint_targets=self.limb_joint_targets,
            stance_width=self.cfg.stance_width,
            toe_out_rad=self.cfg.toe_out_rad,
        )
        return shared_standing_quality(
            height=fields["root_pose"][:, 2],
            root_up=self.upright_component(fields["root_pose"][:, 3:7]),
            torso_up=self.upright_component(body_pose[:, self.torso_index, 3:7]),
            linear_velocity=velocity[:, :3],
            angular_velocity=velocity[:, 3:6],
            feet_support=feet_support,
            wrist_load=wrist_load,
            limb_quality=limb,
            limb_fraction=self.cfg.limb_fraction,
        )

    def reward(
        self,
        before,
        action,
        following,
        goals,
        style_reward,
    ):
        batch_size = following.shape[0]

        if before.shape != following.shape:
            raise ValueError("before 与 following 的形状必须一致")
        if action.shape != (
            batch_size,
            self.spec.num_actions,
        ):
            raise ValueError("action 必须为 [B, 动作数量]")
        if goals.shape != (batch_size, 0):
            raise ValueError("起身任务不使用外部目标，goals 必须为 [B, 0]")
        if style_reward.shape != (batch_size,):
            raise ValueError("style_reward 必须为 [B]")

        previous = unpack_state(
            before,
            self.spec,
        )
        current = unpack_state(
            following,
            self.spec,
        )

        cfg = self.cfg
        joint_ids = self.control_joint_ids

        joint_position = (
            current["joint_position"][:, joint_ids]
        )

        lower_violation = (
            self.lower_limits[joint_ids]
            - joint_position
        ).clamp_min(0.0)

        upper_violation = (
            joint_position
            - self.upper_limits[joint_ids]
        ).clamp_min(0.0)

        joint_violation = (
            lower_violation + upper_violation
        ).sum(dim=-1)

        action_rate = (
            action - previous["previous_action"]
        ).square().sum(dim=-1)

        # 根据相邻状态的真实时间间隔估算关节加速度。
        joint_acceleration = (
            (
                current["joint_velocity"][:, joint_ids]
                - previous["joint_velocity"][:, joint_ids]
            )
            / cfg.step_dt
        )

        joint_acceleration_cost = (
            joint_acceleration.square().sum(dim=-1)
        )

        terms = {
            "standing": (
                cfg.standing_weight
                * self.standing_quality(following)
            ),
            "style": (
                cfg.style_weight * style_reward
            ),
            "action_rate": (
                -cfg.action_rate_weight * action_rate
            ),
            "joint_limits": (
                -cfg.joint_limit_weight
                * joint_violation
            ),
            "joint_acc": (
                -cfg.joint_acc_weight
                * joint_acceleration_cost
            ),
            "out_of_bounds": (
                -cfg.boundary_weight
                * self.termination_probability(
                    following
                )
                / cfg.step_dt
            ),
        }

        # 只在这里乘一次控制周期。
        terms = {
            name: value * cfg.step_dt
            for name, value in terms.items()
        }

        total = torch.stack(
            tuple(terms.values()),
            dim=0,
        ).sum(dim=0)

        return total, terms

    def termination_probability(self, state):
        """只对离开实验区域进行软终止。"""
        fields = unpack_state(state, self.spec)

        distance = torch.linalg.vector_norm(
            fields["root_pose"][:, :2],
            dim=-1,
        )

        return torch.sigmoid(
            (
                distance
                - self.cfg.max_distance
            )
            / self.cfg.boundary_transition
        )

    def terminated(self, state):
        """倒地本身不终止，水平越界才终止。"""
        fields = unpack_state(state, self.spec)

        distance = torch.linalg.vector_norm(
            fields["root_pose"][:, :2],
            dim=-1,
        )

        return distance > self.cfg.max_distance
