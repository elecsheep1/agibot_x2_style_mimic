+class ObservationNormalizer(nn.Module):
+    """单帧观测统计；只由真实采样显式更新，forward 不修改统计量。"""
+
+    def __init__(self, dimension, minimum_std=0.01, clip=10.0):
+        super().__init__()
+        self.minimum_std = float(minimum_std)
+        self.clip = float(clip)
+        self.register_buffer("mean", torch.zeros(dimension))
+        self.register_buffer("variance", torch.ones(dimension))
+        self.register_buffer("count", torch.zeros((), dtype=torch.float64))
+
+    @torch.no_grad()
+    def update(self, values):
+        if values.ndim != 2 or values.shape[1] != self.mean.numel():
+            raise ValueError("观测统计输入必须为 [样本数, 单帧维度]")
+        if values.shape[0] == 0:
+            return
+        values = values.detach().to(self.mean)
+        if not bool(torch.isfinite(values).all()):
+            raise ValueError("观测统计输入包含 NaN/Inf")
+        batch_mean = values.mean(dim=0)
+        batch_variance = values.var(dim=0, unbiased=False)
+        batch_count = self.count.new_tensor(values.shape[0])
+        total = self.count + batch_count
+        ratio = (batch_count / total).to(self.mean.dtype)
+        delta = batch_mean - self.mean
+        self.variance.copy_(
+            (1.0 - ratio) * self.variance
+            + ratio * batch_variance
+            + ratio * (1.0 - ratio) * delta.square()
+        )
+        self.mean.add_(ratio * delta)
+        self.count.copy_(total)
+
+    def forward(self, values):
+        std = self.variance.clamp_min(self.minimum_std ** 2).sqrt()
+        return ((values - self.mean) / std).clamp(-self.clip, self.clip)
 
 
