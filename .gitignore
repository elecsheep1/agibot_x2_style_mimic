# Local assistant workflow artifacts
docs/superpowers/

# USD/USDA/USDC/USDZ and robot meshes are runtime assets.
# Keep them versioned; use .gitattributes and Git LFS for large files.
# Do not ignore __init__.py, __init__.pyi, tests/, or all __* names.
